# Streamlit Secrets 예시 — 실제 secrets.toml 은 .gitignore 로 커밋 제외됩니다.
#
# 배포(Streamlit Cloud): 앱 → Settings → Secrets 에 아래 내용을 붙여넣으세요.
# 로컬: 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요 (또는 환경변수 ANTHROPIC_API_KEY 사용).
#
# ⚠️ 키를 코드/깃에 넣지 마세요. 공개 데모에 노출된 키는 즉시 소진 대상이므로
#    Anthropic 콘솔에서 월 지출한도를 걸어두는 것을 권장합니다.

ANTHROPIC_API_KEY = "sk-ant-api03-xxxxxxxx"

# 선택: 비용을 낮추려면 저비용 모델로 교체 (기본값 claude-opus-4-8)
# ANTHROPIC_MODEL = "claude-haiku-4-5"
